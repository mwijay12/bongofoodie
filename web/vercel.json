{
  "version": 2,
  "framework": "nextjs",
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/mobile-app",
      "destination": "/mobile-app/index.html"
    },
    {
      "source": "/mobile-app/",
      "destination": "/mobile-app/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    }
  ]
}
