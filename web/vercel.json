{
  "version": 2,
  "framework": "nextjs",
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/mobile-app",
      "destination": "/mobile-app/index.html"
    },
    {
      "source": "/mobile-app/",
      "destination": "/mobile-app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    }
  ]
}
