# ============================================================================
# BONGO FOODIE v2 — ENVIRONMENT TEMPLATE
# Copy this file to `.env` (root) and `web/.env.local` (for Next.js web app)
# ============================================================================

# 1. Supabase Public Credentials (safe for Flutter --dart-define & Next.js)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 2. Supabase Admin / Migration Credentials (SERVER-ONLY — NEVER ship in mobile!)
SUPABASE_ACCESS_TOKEN=sbp_YOUR_PERSONAL_ACCESS_TOKEN
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_POOLER_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 3. Admin Account Provisioning (optional overrides for `npm run supabase:setup`)
ADMIN_EMAIL=mwijaydavie@gmail.com
ADMIN_PASSWORD=ChangeMeStrong2026!
DEMO_PASSWORD=YOUR_UNIQUE_DEMO_PASSWORD

# 4. Server-Side AI Provider Keys (used by Next.js `/api/chef/*` & Supabase Edge Function)
GEMINI_KEYS=key1,key2
SILICONFLOW_KEY=your_siliconflow_flux_key
OPENROUTER_KEYS=your_openrouter_key
